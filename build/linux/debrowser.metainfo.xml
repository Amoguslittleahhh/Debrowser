<?xml version="1.0" encoding="UTF-8"?>
<!--
  The AppStream entry for software centres. A template: build/linux/before-pack.js
  fills in the version, its date and the homepage for each build.
-->
<component type="desktop-application">
  <id>dev.debrowser.app</id>
  <launchable type="desktop-id">debrowser.desktop</launchable>
  <name>Debrowser</name>
  <summary>A web browser that gives your computer's memory back</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.amoguslittleahhh">
    <name>Amoguslittleahhh</name>
  </developer>
  <description>
    <p>
      Debrowser decides, every two seconds, how much memory and processor time each
      tab may hold, so a tab you are not looking at costs almost nothing, and you
      cannot tell.
    </p>
    <ul>
      <li>Tabs you leave go to sleep and wake when you come back</li>
      <li>Spaces, split view, tab groups and a built-in ad and tracker blocker</li>
      <li>Private windows that go through Tor, with a circuit per site</li>
      <li>Passwords and passkeys kept encrypted on this computer</li>
    </ul>
  </description>
  <icon type="stock">debrowser</icon>
  <screenshots>
    <screenshot type="default">
      <caption>Debrowser in its default design, on a new tab</caption>
      <image>https://raw.githubusercontent.com/Amoguslittleahhh/Debrowser/claude/master-build/docs/screenshots/hero.png</image>
    </screenshot>
    <screenshot>
      <caption>The four designs to choose from</caption>
      <image>https://raw.githubusercontent.com/Amoguslittleahhh/Debrowser/claude/master-build/docs/screenshots/designs.png</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Network</category>
    <category>WebBrowser</category>
  </categories>
  <url type="homepage">@HOMEPAGE@</url>
  <url type="bugtracker">@HOMEPAGE@/issues</url>
  <url type="vcs-browser">@HOMEPAGE@</url>
  <provides>
    <binary>debrowser</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
